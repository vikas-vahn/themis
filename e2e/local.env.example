# Copy to e2e/local.env (gitignored) and adjust. Every value is optional.

# Checkouts of the repos under test. Default: siblings of the themis checkout.
#PLUTUS_DIR=/path/to/plutus-java
#ATLAS_DIR=/path/to/atlas-rn
#PERSEUS_DIR=/path/to/perseus

# Host ports published by the stack and the web preview server.
#E2E_API_PORT=18080
#E2E_ADMIN_PORT=18081
#E2E_MOCKS_PORT=14010
#E2E_WEB_PORT=15173

# 1 = reuse existing builds instead of rebuilding: the backend JAR, perseus'
# node_modules, and the APK named by E2E_ATLAS_APK.
#E2E_SKIP_BUILD=1
# 1 = reuse only the backend JAR (what CI does: one job builds it for the rest).
#E2E_SKIP_BACKEND_BUILD=1
#E2E_ATLAS_APK=/path/to/atlas-e2e.apk

# Fixture identity (1-5) each UI suite uses. Change it to re-run a suite
# against a stack you kept up, since an identity's PAN can be linked only once.
#E2E_WEB_IDENTITY=1
#E2E_MOBILE_IDENTITY=1

# Android emulator image and extra emulator flags (drop -no-window to watch).
#E2E_AVD=themis_e2e
#E2E_EMULATOR_ARGS=-gpu host

# 1 = leave the stack running after `run.sh all`, for debugging.
#E2E_KEEP_STACK=1
