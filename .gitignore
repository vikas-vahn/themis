.DS_Store
node_modules/

# Bruno local-only env overrides / secrets
bruno/**/*.env.local
bruno/**/.env
bruno/**/environments/*.local.bru

# Maestro run artifacts
maestro/.maestro/
maestro/**/*.log

# Mock server (Cloudflare Worker) local state and secrets
mock-server/.wrangler/
mock-server/.dev.vars

# Tunnel per-developer settings (may hold a tunnel token)
tunnel/.env

# E2E run state: generated backend config (contains values from plutus-java config.yml), logs, reports
e2e/.run/
e2e/node_modules/
e2e/local.env
