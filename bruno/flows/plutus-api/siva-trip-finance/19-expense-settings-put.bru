meta {
  name: Set a truck's salary method to PERCENT_OF_FREIGHT 12.5
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/api/v2/trucks/{{plutusTripFinanceTruckId}}/expense-settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{plutusTripFinanceOwnerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "salaryMethod": "PERCENT_OF_FREIGHT",
    "salaryPercent": 12.5
  }
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
  res.body.success: eq true
  res.body.data.salaryMethod: eq PERCENT_OF_FREIGHT
  res.body.data.salaryPercent: eq 12.5
}

docs {
  `PUT /api/v2/trucks/{truckId}/expense-settings` (VAHN_ADMIN, TORG_ADMIN). Applies to trips whose salary is first
    priced after this; trips already priced keep theirs. mileage and defSettings left null are unchanged. Audited
    (updatedByUserId, updatedAt are overwritten, so they can't be restored exactly).
}
