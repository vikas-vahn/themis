meta {
  name: 2. Verify OTP (Fleet Owner)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{plutusApiRoadTaxOwnerPhone}}",
    "otp": "{{plutusApiRoadTaxOwnerOtp}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.user.role: eq TORG_ADMIN
}

script:post-response {
  bru.setVar("plutusApiRoadTaxOwnerToken", res.body.data.accessToken);
}

docs {
  Captures the owner token as the runtime variable `plutusApiRoadTaxOwnerToken` (not written to disk).
}
