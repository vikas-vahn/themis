meta {
  name: 12. Admin close again (409)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/admin/assistance-requests/{{plutusApiRoadTaxHelpRequestId}}/close
  body: json
  auth: bearer
}

auth:bearer {
  token: {{vahnAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "CANCELLED",
    "note": "themis cleanup"
  }
}

script:pre-request {
  if (!bru.getVar("plutusApiRoadTaxHelpRequestId")) { bru.runner.skipRequest(); }
}

assert {
  res.body.statusCode: eq 409
}

docs {
  Already closed: 409.
}
