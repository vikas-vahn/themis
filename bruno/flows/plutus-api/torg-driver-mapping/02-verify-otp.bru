meta {
  name: 2. Verify OTP (Torg Admin)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{torgAdminPhone}}",
    "otp": "{{torgAdminOtp}}"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.data.accessToken);
}

docs {
  Overwrites {{accessToken}} with the torg admin's token — every request after this one in
  THIS flow acts as the truck owner, not the driver. If you need the driver's token again
  afterwards (e.g. to re-run something from driver-onboarding), re-run that flow's own
  verify-otp step.
}
