meta {
  name: 05. P Sreekanth
  type: http
  seq: 5
}

post {
  url: {{plutusBaseUrl}}/api/drivers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "P SREEKANTH",
    "phone": "9347918196",
    "licenseNumber": "AP30420170001766",
    "dateOfBirth": "1996-05-18"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.name: eq "P SREEKANTH"
  res.body.data.phone: eq "9347918196"
}

docs {
  One-time bulk import (2026-10-22), row 05 of 28 from `DRIVER_LICENSE_DETAILS_(1).csv`.
  Source truck registration number AP39VD6699 is NOT sent in this request (out of scope for
  `POST /api/drivers` — driver-to-truck assignment is a separate concern, not part of this
  endpoint). See the flow's `folder.bru` for the full import notes (skipped/adjusted rows).
}
