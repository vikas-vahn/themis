meta {
  name: 01. K C Sekhar Reddy
  type: http
  seq: 1
}

post {
  url: {{plutusBaseUrl}}/api/drivers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "K C SEKHAR REDDY",
    "phone": "9908206951",
    "licenseNumber": "39501998",
    "dateOfBirth": "1980-05-12"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.name: eq "K C SEKHAR REDDY"
  res.body.data.phone: eq "9908206951"
}

docs {
  One-time bulk import (2026-10-22), row 01 of 28 from `DRIVER_LICENSE_DETAILS_(1).csv`.
  Source truck registration number AP39UQ6688 is NOT sent in this request (out of scope for
  `POST /api/drivers` — driver-to-truck assignment is a separate concern, not part of this
  endpoint). See the flow's `folder.bru` for the full import notes (skipped/adjusted rows).
}
