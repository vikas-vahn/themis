meta {
  name: 141. Preview HALFY -> MONTH (plan 11 -> 5)
  type: http
  seq: 141
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change/preview?planId=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setEnvVar("subRevampQuoteNet", String(res.body.data.netPayable));
  bru.setEnvVar("subRevampQuoteCharge", String(res.body.data.charge));
  bru.setEnvVar("subRevampQuoteCreditAdv", String(res.body.data.creditToAdvance));
  bru.setEnvVar("subRevampQuoteCredit", String(res.body.data.credit));
}

tests {
  test("everything paid was advance, so it goes back to advance and nothing to the wallet", function() {
    const q = res.body.data;
    expect(q.changeType).to.equal("CYCLE_CHANGE");
    expect(Number(q.charge)).to.be.closeTo(3 * 352.82, 0.011);
    expect(Number(q.credit)).to.equal(0);
    expect(Number(q.creditToAdvance)).to.be.closeTo(Number(bru.getEnvVar("subRevampBillingTotal")), 0.011);
    expect(Number(q.netPayable)).to.be.closeTo(Number(q.charge) - Number(q.creditToAdvance), 0.011);
    expect(Number(q.shortfall)).to.equal(0);
  });
}

docs {
  A cycle change on day 0 refunds the whole billing and bills the new cycle in full.
}
