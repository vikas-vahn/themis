meta {
  name: 13. Flags off: list-external-payments refused
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 403
}

docs {
  With the flag off the route refuses with a body statusCode of 403 (HTTP is 200 through the response filter).
}
