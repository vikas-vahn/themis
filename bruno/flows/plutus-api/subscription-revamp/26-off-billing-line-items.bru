meta {
  name: 26. Flags off: billing with line items (one BASE per billing)
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  const b = res.body.data;
  bru.setEnvVar("subRevampBillingTotal", String(b.totalAmount));
  bru.setEnvVar("subRevampBillingTrucks", String(b.noOfTrucks));
}

tests {
  test("billing has exactly one BASE item whose amount equals the total (dual-write)", function() {
    const b = res.body.data;
    const base = (b.lineItems || []).filter(i => i.itemType === "BASE");
    expect(base.length).to.equal(1);
    expect(Number(base[0].amount)).to.be.closeTo(Number(b.totalAmount), 0.011);
  });
  test("cancellation notes are visible to VAHN_ADMIN", function() {
    expect(res.body.data).to.have.property("cancelledAt");
  });
}

docs {
  Unflagged read. The scheduler wrote this billing with the legacy maths and the BASE line item dual-write.
}
