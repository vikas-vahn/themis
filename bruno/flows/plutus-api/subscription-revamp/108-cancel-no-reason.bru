meta {
  name: 108. Cancel without a reason is refused
  type: http
  seq: 108
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refundMode": "FULL",
    "trialEndDate": "{{subRevampPlus1}}"
  }
}

assert {
  res.body.statusCode: eq 400
}
