meta {
  name: 252. Cancel PRO_RATA, billing restarts in 10 days (static admin token)
  type: http
  seq: 252
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refundMode": "PRO_RATA",
    "newBillingStartDate": "{{subRevampPlus10}}",
    "reason": "ENG-690 staging test: pro-rata refund"
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("CANCELLED, refund = preview, subscription ACTIVE with the next billing date", function() {
    const d = res.body.data;
    expect(d.billing.status).to.equal("CANCELLED");
    expect(Number(d.refund.amount)).to.equal(Number(bru.getEnvVar("subRevampPreviewRefund")));
    expect(d.subscription.status).to.equal("ACTIVE");
    expect(d.subscription.nextBillingDate).to.equal(bru.getEnvVar("subRevampPlus10"));
    expect((d.billing.lineItems || []).filter(i => i.itemType === "REFUND").length).to.be.greaterThan(0);
  });
  test("static token: cancelledBy is null and every line item created_by is null", function() {
    expect(res.body.data.billing.cancelledBy).to.equal(null);
    (res.body.data.billing.lineItems || []).filter(i => i.itemType === "REFUND").forEach(i => expect(i.createdBy).to.equal(null));
  });
}

docs {
  Sent with the static VAHN_ADMIN token: allowed, stored with no user id (billing.cancelled_by null). Needs `subRevampStaticToken` at run time.
}
