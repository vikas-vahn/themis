meta {
  name: 193. Cycle change MONTH -> HALFY (static admin token)
  type: http
  seq: 193
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planId": 11,
    "expectedNetPayable": {{subRevampQuoteNet}},
    "reason": "ENG-690 test: cycle change back as admin"
  }
}

assert {
  res.body.statusCode: eq 200
}

script:pre-request {
  bru.setEnvVar("subRevampOldBillingId", bru.getEnvVar("subRevampBillingId"));
}

script:post-response {
  bru.setEnvVar("subRevampBillingId", String(res.body.data.billing.id));
}

tests {
  test("new half-yearly billing paid in full", function() {
    const d = res.body.data;
    expect(d.billing.subscriptionPlan.id).to.equal(11);
    expect(d.billing.status).to.equal("PAID");
    expect(Number(d.billing.dueAmount)).to.equal(0);
  });
  test("static token: line items created_by is null", function() {
    (res.body.data.billing.lineItems || []).forEach(i => expect(i.createdBy, i.itemType).to.equal(null));
  });
}

docs {
  Sent with the static VAHN_ADMIN token (acting for the torg): allowed, line items stored with created_by null. An admin-made plan change needs a `reason` (400 "reason is required" without one, as on the 2026-11-05 run). Needs `subRevampStaticToken` at run time.
}
