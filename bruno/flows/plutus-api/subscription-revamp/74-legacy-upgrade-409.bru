meta {
  name: 74. Legacy PUT /{torgId} for an upgrade returns 409 with the quote
  type: http
  seq: 74
}

put {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}?planId=5&reason=ENG-690%20legacy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

assert {
  res.body.statusCode: eq 409
}

tests {
  test("the quote rides in data and nothing moved", function() {
    expect(res.body.data.changeType).to.equal("UPGRADE");
    expect(Number(res.body.data.netPayable)).to.be.greaterThan(0);
  });
}

docs {
  With the flag on, the older routes cannot move money blind: a charge or credit is a 409 carrying the quote.
}
