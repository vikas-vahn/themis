meta {
  name: 153. Preview MONTH -> HALFY (plan 5 -> 11) with too little money
  type: http
  seq: 153
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change/preview?planId=11
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setEnvVar("subRevampQuoteNet", String(res.body.data.netPayable));
  bru.setEnvVar("subRevampQuoteShortfall", String(res.body.data.shortfall));
}

tests {
  test("shortfall = what is needed less advance, wallet and the refund of the closed billing", function() {
    const q = res.body.data;
    expect(q.changeType).to.equal("CYCLE_CHANGE");
    expect(Number(q.charge)).to.be.closeTo(3 * 1621.32, 0.011);
    const available = Number(q.advanceAvailable) + Number(q.walletAvailable) + Number(q.credit) + Number(q.creditToAdvance);
    expect(Number(q.shortfall)).to.be.closeTo(Number(q.charge) + Number(q.carriedForward) - available, 0.011);
    expect(Number(q.shortfall)).to.be.greaterThan(0);
  });
}
