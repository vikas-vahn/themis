meta {
  name: 258. Explicit allocation to a billing of another torg is refused
  type: http
  seq: 258
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 10,
    "mode": "UPI",
    "referenceNumber": "UTR-OTHER-{{subRevampRun}}",
    "paymentDate": "{{subRevampToday}}",
    "proofKey": "themis/subrevamp/proof.png",
    "requestId": "subrevamp-other-{{subRevampRun}}",
    "allocations": [ { "targetType": "SUBSCRIPTION_BILLING", "targetId": 1, "amount": 10 } ]
  }
}

assert {
  res.body.statusCode: gte 400
}

tests {
  test("nothing recorded for the foreign billing", function() {
    expect(res.body.statusCode).to.be.oneOf([400, 404, 409]);
  });
}

docs {
  The request is refused as a whole, so the payment is not recorded (the later list/advance reads show no change). Billing 1 belongs to another torg and is only addressed, not read.
}
