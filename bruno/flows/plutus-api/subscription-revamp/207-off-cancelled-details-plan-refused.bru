meta {
  name: 207. Flags off: PUT /{torgId} refuses a CANCELLED subscription
  type: http
  seq: 207
}

put {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}?planId=5&reason=ENG-690%20test
  body: none
  auth: bearer
}

