meta {
  name: 51. Record external payment P2 (bank transfer) with the static admin token
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 500,
    "mode": "BANK_TRANSFER",
    "referenceNumber": "NEFT-690-{{subRevampRun}}",
    "paymentDate": "{{subRevampToday}}",
    "proofKey": "themis/subrevamp/proof.png",
    "requestId": "subrevamp-p2-{{subRevampRun}}"
  }
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setEnvVar("subRevampPayment2Id", String(res.body.data.externalPayment.id));
}

tests {
  test("advance is 1500", function() {
    expect(Number(res.body.data.advanceBalance)).to.equal(1500);
  });
  test("static token: recordedBy is null (stored as admin, no user id)", function() {
    expect(res.body.data.externalPayment.recordedBy).to.equal(null);
  });
}

docs {
  Sent with the static VAHN_ADMIN token (zeus): allowed, and recorded with no user id (recordedBy null). Needs `subRevampStaticToken` at run time.
  Step 52 reverses it, so the advance returns to 1000 and the later readings are unchanged.
}
