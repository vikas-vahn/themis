meta {
  name: 73. Upgrade without expectedNetPayable is refused for a torg user
  type: http
  seq: 73
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planId": 5
  }
}

assert {
  res.body.statusCode: eq 400
}
