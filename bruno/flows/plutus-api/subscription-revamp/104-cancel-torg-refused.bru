meta {
  name: 104. Cancel as TORG_ADMIN is refused
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refundMode": "FULL",
    "reason": "should not work"
  }
}

assert {
  res.body.statusCode: eq 403
}
