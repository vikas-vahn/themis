meta {
  name: 84. Downgrade 5 -> 7 by VAHN_ADMIN is scheduled, no money moves
  type: http
  seq: 84
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planId": 7,
    "reason": "ENG-690 test downgrade"
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("DOWNGRADE_SCHEDULED with a pending plan from the next billing", function() {
    const d = res.body.data;
    expect(d.changeType).to.equal("DOWNGRADE_SCHEDULED");
    expect(Number(d.netPayable)).to.equal(0);
    expect(d.pendingPlan.id).to.equal(7);
    expect(d.pendingPlanEffectiveDate).to.equal(bru.getEnvVar("subRevampBillingEnd"));
  });
}

docs {
  Plan 7 is OFFERED, which only VAHN_ADMIN can assign.
}
