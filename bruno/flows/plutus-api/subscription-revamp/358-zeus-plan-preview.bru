meta {
  name: 358. zeus: plan change preview to the annual plan (id 8)
  type: http
  seq: 358
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change/preview?src=zeus&planId=8
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setEnvVar("subRevampZeusNetPayable", String(res.body.data.netPayable));
}

tests {
  test("preview shape", function() {
    const d = res.body.data;
    ["changeType","netPayable","creditToAdvance","advanceAvailable","walletAvailable","shortfall"].forEach(k => expect(d).to.have.property(k));
    expect(d.toPlan.id).to.equal(8);
  });
}

docs {
  Captures subRevampZeusNetPayable.
}
