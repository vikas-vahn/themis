meta {
  name: 328. zeus: advance balance after the reversal
  type: http
  seq: 328
}

get {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/advance-balance?src=zeus
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("advance back to the first reading", function() {
    expect(Number(res.body.data.advanceBalance)).to.be.closeTo(Number(bru.getEnvVar("subRevampZeusAdvance0")), 0.011);
  });
}

docs {
  (no extra notes)
}
