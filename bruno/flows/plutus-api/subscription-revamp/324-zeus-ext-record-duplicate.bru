meta {
  name: 324. zeus: same requestId again is a duplicate, not a second payment
  type: http
  seq: 324
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments?src=zeus
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 70,
    "mode": "UPI",
    "referenceNumber": "UTR-ZEUS-{{subRevampRun}}",
    "paymentDate": "{{subRevampToday}}",
    "proofKey": "themis/zeus-retest/proof.txt",
    "remarks": "ENG-690 zeus re-test",
    "requestId": "zeus-retest-{{subRevampRun}}"
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("duplicate true, same payment id, advance unchanged", function() {
    const d = res.body.data;
    expect(d.duplicate).to.equal(true);
    expect(String(d.externalPayment.id)).to.equal(bru.getEnvVar("subRevampZeusPaymentId"));
    expect(Number(d.advanceBalance)).to.be.closeTo(Number(bru.getEnvVar("subRevampZeusAdvance0")) + 70, 0.011);
  });
}

docs {
  Idempotency by requestId: the second call returns the first payment with duplicate true and moves no money.
}
