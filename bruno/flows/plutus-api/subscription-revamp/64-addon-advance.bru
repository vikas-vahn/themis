meta {
  name: 64. The add-on was paid from advance before the wallet
  type: http
  seq: 64
}

get {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/advance-balance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  const cur = Number(res.body.data.advanceBalance);
  bru.setEnvVar("subRevampAdvancePrev", String(bru.getEnvVar("subRevampAdvanceBalance") || cur));
  bru.setEnvVar("subRevampAdvanceBalance", String(cur));
}

tests {
  const cur = Number(bru.getEnvVar("subRevampAdvanceBalance"));
  const prev = Number(bru.getEnvVar("subRevampAdvancePrev"));
  test("advance dropped by the add-on amount", function() {
    expect(prev - cur).to.be.closeTo(Number(bru.getEnvVar("subRevampBillingTotal")) - 233.64, 0.011);
  });
}

docs {
  Advance is drawn before the wallet. Advance was 900; billing total minus the original BASE (233.64) is the add-on.
}
