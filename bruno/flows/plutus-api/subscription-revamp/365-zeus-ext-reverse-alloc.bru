meta {
  name: 365. zeus: reverse the allocated payment, the due reopens on the billing
  type: http
  seq: 365
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments/{{subRevampZeusPayment3Id}}/reverse?src=zeus
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampStaticToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "ENG-690 zeus re-test: reopen the due"
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("REVERSED and the billing is listed as reopened", function() {
    const d = res.body.data;
    expect(d.externalPayment.status).to.equal("REVERSED");
    expect(d.reopenedBillingIds.map(String)).to.include(bru.getEnvVar("subRevampZeusBillingId"));
  });
}

docs {
  The 40 allocation is released, so the due is back where it was before 361.
}
