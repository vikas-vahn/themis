meta {
  name: 256. External payment dated in the future is refused
  type: http
  seq: 256
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 10,
    "mode": "UPI",
    "referenceNumber": "UTR-FUT-{{subRevampRun}}",
    "paymentDate": "2099-01-01",
    "proofKey": "themis/subrevamp/proof.png",
    "requestId": "subrevamp-future-{{subRevampRun}}"
  }
}

assert {
  res.body.statusCode: eq 400
}
