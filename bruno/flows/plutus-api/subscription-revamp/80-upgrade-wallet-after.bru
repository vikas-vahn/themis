meta {
  name: 80. Wallet unchanged by the upgrade (advance paid it)
  type: http
  seq: 80
}

get {
  url: {{baseUrl}}/api/wallets/torg/{{subRevampTorgId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  const cur = Number(res.body.data[0].balance);
  bru.setEnvVar("subRevampWalletPrev", String(bru.getEnvVar("subRevampWalletBalance") || cur));
  bru.setEnvVar("subRevampWalletBalance", String(cur));
}

tests {
  const cur = Number(bru.getEnvVar("subRevampWalletBalance"));
  const prev = Number(bru.getEnvVar("subRevampWalletPrev"));
  test("no wallet movement", function() {
    expect(cur).to.be.closeTo(prev, 0.011);
  });
}

docs {
  Reads the test torg admin wallet balance. subRevampWalletPrev is the previous reading.
}
