meta {
  name: 189. Closed billing: PLAN_CHANGE_CREDIT, REFUND items, external ones without a wallet transaction
  type: http
  seq: 189
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampOldBillingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("credit and refund items; externally funded refunds have no wallet transaction", function() {
    const b = res.body.data;
    expect(b.status).to.equal("CANCELLED");
    const items = b.lineItems || [];
    expect(items.filter(i => i.itemType === "PLAN_CHANGE_CREDIT").length).to.equal(1);
    const refunds = items.filter(i => i.itemType === "REFUND");
    expect(refunds.length).to.be.greaterThan(0);
    expect(refunds.filter(r => r.walletTransactionId == null).length).to.be.greaterThan(0);
    expect(refunds.filter(r => r.walletTransactionId != null).length).to.equal(1);
    expect(b.cancellationReason).to.contain("Plan change to");
  });
}
