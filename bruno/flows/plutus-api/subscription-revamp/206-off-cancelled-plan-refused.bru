meta {
  name: 206. Flags off: PUT /{torgId}/plan refuses a CANCELLED subscription
  type: http
  seq: 206
}

put {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan?planId=5&reason=ENG-690%20test
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 400
}
