meta {
  name: 122. Cancel preview FULL refunds everything paid
  type: http
  seq: 122
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/cancel-preview?refundMode=FULL&trialEndDate={{subRevampPlus1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setEnvVar("subRevampPreviewRefund", String(res.body.data.refund.amount));
}

tests {
  test("FULL = net paid, split across payments, lands in the wallet", function() {
    const d = res.body.data;
    expect(d.refund.mode).to.equal("FULL");
    expect(Number(d.refund.amount)).to.be.closeTo(Number(d.refund.netPaid), 0.011);
    expect(Number(d.refund.amount)).to.be.closeTo(Number(bru.getEnvVar("subRevampBillingPaid")), 0.011);
    const s = (d.refund.allocations || []).reduce((t, a) => t + Number(a.amount), 0);
    expect(s).to.be.closeTo(Number(d.refund.amount), 0.011);
    expect(d.refund.trialEndDate).to.equal(bru.getEnvVar("subRevampPlus1"));
  });
}

docs {
  With a trialEndDate the subscription goes into TRIAL until then instead of re-billing. Captures subRevampPreviewRefund.
}
