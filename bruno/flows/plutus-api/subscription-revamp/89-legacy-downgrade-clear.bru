meta {
  name: 89. Clear the pending downgrade again
  type: http
  seq: 89
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planId": 5
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("cleared", function() {
    expect(res.body.data.changeType).to.equal("PENDING_CLEARED");
  });
}
