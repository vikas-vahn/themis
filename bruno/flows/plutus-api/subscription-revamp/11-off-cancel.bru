meta {
  name: 11. Flags off: cancel refused
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refundMode": "FULL",
    "reason": "flag off check"
  }
}

assert {
  res.body.statusCode: eq 403
}

docs {
  With the flag off the route refuses with a body statusCode of 403 (HTTP is 200 through the response filter).
}
