meta {
  name: 242. Waiving the remainder is refused when the wallet cannot pay the agreed part
  type: http
  seq: 242
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/partial-charge
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mode": "AMOUNT",
    "amount": 1000,
    "createDue": false,
    "reason": "ENG-690 test",
    "expectedDueAmount": {{subRevampBillingDue}}
  }
}

assert {
  res.body.statusCode: eq 400
}

docs {
  Only about 500 is left in the wallet, less than the 1000 asked, so the rest cannot be waived.
}
