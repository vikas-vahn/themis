meta {
  name: 05. Flags off: mark it verified
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/trucks/mark-as-verified?remarks=ENG-690%20test%20truck&panCardId={{subRevampPanId}}&isConsentGiven=false
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "entityIds": [{{subRevampTruck3Id}}]
  }
}

assert {
  res.body.statusCode: eq 200
}
