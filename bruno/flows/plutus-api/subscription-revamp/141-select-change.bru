meta {
  name: 141. Select plan 8 (annual) while no billing is current
  type: http
  seq: 141
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planId": 8
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("SELECTION applied, dates untouched, no billing", function() {
    const d = res.body.data;
    expect(d.changeType).to.equal("SELECTION");
    expect(d.subscription.plan.id).to.equal(8);
    expect(d.subscription.status).to.be.oneOf(["TRIAL", "ACTIVE"]);
    expect(d.billing == null).to.equal(true);
  });
}
