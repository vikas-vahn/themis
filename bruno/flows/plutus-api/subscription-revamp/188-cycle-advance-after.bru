meta {
  name: 188. Advance = before + refunded to advance - new charge
  type: http
  seq: 188
}

get {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/advance-balance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  const cur = Number(res.body.data.advanceBalance);
  bru.setEnvVar("subRevampAdvancePrev", String(bru.getEnvVar("subRevampAdvanceBalance") || cur));
  bru.setEnvVar("subRevampAdvanceBalance", String(cur));
}

tests {
  const cur = Number(bru.getEnvVar("subRevampAdvanceBalance"));
  const prev = Number(bru.getEnvVar("subRevampAdvancePrev"));
  test("conservation", function() {
    expect(cur).to.be.closeTo(prev + Number(bru.getEnvVar("subRevampQuoteCreditAdv")) - Number(bru.getEnvVar("subRevampQuoteCharge")), 0.011);
  });
}

docs {
  Reads the torg advance balance. subRevampAdvancePrev is the previous reading.
}
