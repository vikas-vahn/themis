meta {
  name: 134. End the trial today so the scheduler bills now
  type: http
  seq: 134
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/trial/extend?trialEndDate={{subRevampToday}}&reason=ENG-690%20test
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("next billing is today", function() {
    expect(res.body.data.nextBillingDate).to.equal(bru.getEnvVar("subRevampToday"));
  });
}

docs {
  After this the hourly billing scheduler creates the next billing. WAIT for it (up to an hour); re-run step 135 until it finds one.
}
