meta {
  name: 200. RESTORE flags to the pre-test state (test window closes)
  type: http
  seq: 200
}

put {
  url: {{baseUrl}}/api/v1/config/subscription-billing
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "config": {
      "lineItemMaths": { "enabled": false },
      "lineItemWrites": { "enabled": true },
      "cancelRefund": { "enabled": false },
      "externalPayments": { "enabled": false },
      "truckAddon": { "enabled": false },
      "partialBilling": { "enabled": false },
      "planChange": { "enabled": false },
      "dueSweep": { "enabled": false }
    },
    "reason": "ENG-690 staging test window over: back to the code defaults"
  }
}

assert {
  res.body.statusCode: eq 200
}

docs {
  ALWAYS run this, pass or fail. Before the test the namespace did not exist (statusCode 404), which means every flag at its
  code default: lineItemMaths off, lineItemWrites ON, cancelRefund/externalPayments/truckAddon/partialBilling/planChange/dueSweep off.
  A config row cannot be deleted through the API, so the equivalent explicit config is written; behaviour is identical to the
  defaults. `subscription-notifications` was never touched.
}
