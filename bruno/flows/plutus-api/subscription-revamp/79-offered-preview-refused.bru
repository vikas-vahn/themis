meta {
  name: 79. Preview of an OFFERED plan is refused for a torg user
  type: http
  seq: 79
}

get {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/plan-change/preview?planId=9
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

assert {
  res.body.statusCode: eq 400
}

docs {
  Plan 9 is OFFERED.
}
