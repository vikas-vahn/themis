meta {
  name: 189. Moving more than the advance is refused
  type: http
  seq: 189
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/advance-balance/move-to-wallet
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 5000,
    "expectedAdvanceBalance": {{subRevampAdvanceBalance}},
    "reason": "ENG-690 test"
  }
}

assert {
  res.body.statusCode: eq 400
}
