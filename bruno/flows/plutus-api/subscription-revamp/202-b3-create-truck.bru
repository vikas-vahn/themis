meta {
  name: 202. Add a truck to the new billing
  type: http
  seq: 202
}

post {
  url: {{baseUrl}}/api/trucks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "registrationNumber": "{{subRevampTruck5Reg}}",
    "torgId": {{subRevampTorgId}}
  }
}

assert {
  res.body.statusCode: eq 200
}

script:pre-request {
  bru.setEnvVar("subRevampTruck5Reg", "MH69AE" + String(Date.now()).slice(-4));
}

script:post-response {
  bru.setEnvVar("subRevampTruck5Id", String(res.body.data.id));
}
