meta {
  name: 270. Admin creates a first live billing on the test torg (set-up for the overlap guard)
  type: http
  seq: 270
}

post {
  url: {{baseUrl}}/api/subscriptions/billings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "subscriptionPlan": {
      "id": 5,
      "name": "Monthly Plan",
      "description": "299 per truck plus gst",
      "pricePerTruck": 299.0,
      "taxPercentage": 18.0,
      "displayPrice": 330.0,
      "features": [
        "View/Manage Fleet",
        "All Payments",
        "Access to Vendor Payment (Transaction Charges applicable)",
        "Tracking/VTS",
        "Automatic trip sheet / settlement workflow",
        "Document storage/visibility",
        "Document Expiry Alerts and SMS (Charges apply)",
        "Driver App",
        "Credit Fuel Management system",
        "24*7 Support"
      ],
      "cycle": "MONTH",
      "gracePeriodDays": 3,
      "extraInfo": {
        "isBestValue": false,
        "basePricePerTruck": 299
      },
      "planType": "OPEN",
      "trialDays": 7,
      "monthlyPricePerTruck": 299.0,
      "totalPricePerTruck": 352.82,
      "taxAmountPerTruck": 53.82,
      "isTaxInclusive": false,
      "isActive": true,
      "isDefault": true,
      "isRecommended": true
    },
    "torg": {
      "id": 685,
      "name": "ZZ ENG-690 Subscription Test Torg",
      "gstId": null,
      "panCardId": 469,
      "directorAadhaarId": null,
      "torgAdminId": 2648,
      "bankAccountList": "[]",
      "companyDetails": "{}",
      "virtualAccountList": "[]",
      "torgEmployeeList": "[]",
      "externalCustomerId": null,
      "status": "ACTIVE",
      "vehicleType": "TRUCK",
      "panCardIds": [
        469
      ],
      "alertsMessage": null,
      "alertsTitle": null,
      "tripSheetSetting": {
        "salaryEnabled": true,
        "foodingEnabled": true,
        "miscellaneousExpenseEnabled": true,
        "fullFuelEnabled": true,
        "fastTagEnabled": true,
        "emptyRunEnabled": true,
        "defEnabled": true,
        "defSettings": null
      },
      "default_compensation_details": null
    },
    "billingStartDate": "{{subRevampToday}}",
    "billingEndDate": "{{subRevampPlus30}}",
    "totalAmount": 352.82,
    "paidAmount": 352.82,
    "dueAmount": 0,
    "status": "PAID",
    "noOfTrucks": 1,
    "paymentDueDate": "{{subRevampToday}}",
    "notes": "ENG-690 overlap-guard test row"
  }
}

assert {
  res.body.statusCode: eq 200
}

script:pre-request {
  const d = new Date(Date.UTC(Number(bru.getEnvVar("subRevampToday").slice(0,4)), Number(bru.getEnvVar("subRevampToday").slice(5,7)) - 1, Number(bru.getEnvVar("subRevampToday").slice(8,10)) + 30));
  bru.setEnvVar("subRevampPlus30", d.toISOString().slice(0, 10));
}

script:post-response {
  bru.setEnvVar("subRevampOverlapA", String(res.body.data.id));
  bru.setEnvVar("subRevampBillingId", String(res.body.data.id));
}

tests {
  test("PAID row with refunded_amount 0", function() {
    expect(res.body.data.status).to.equal("PAID");
    expect(Number(res.body.data.refundedAmount || 0)).to.equal(0);
  });
}

docs {
  Raw admin create (POST /api/subscriptions/billings). The two rows are PAID and carry no payments, so nothing is due and nothing can be charged against them. Do this LATE: two live billings block cancel and cycle change.
}
