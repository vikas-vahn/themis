meta {
  name: 07. Find the billing the scheduler created (needed by 10-24)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/subscriptions/billings/torg/{{subRevampTorgId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  const live = res.body.data.filter(b => b.status !== "CANCELLED");
  if (live.length > 0) { bru.setEnvVar("subRevampBillingId", String(live[0].id)); }
}

tests {
  test("exactly one live billing exists", function() {
    expect(res.body.data.filter(b => b.status !== "CANCELLED").length).to.equal(1);
  });
}

docs {
  Steps 10, 11 and 18 build URLs from subRevampBillingId, which step 25 used to set; on a fresh torg it is still empty at step 10 (HTTP 400 with no body
  statusCode). This step sets it. It needs the hourly scheduler to have billed the torg already (trial ended today, no billing yet).
}
