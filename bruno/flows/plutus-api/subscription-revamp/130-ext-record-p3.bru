meta {
  name: 130. Record external payment P3 (6000) to fund the next billing from advance
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 6000,
    "mode": "BANK_TRANSFER",
    "referenceNumber": "NEFT-690-P3-{{subRevampRun}}",
    "paymentDate": "{{subRevampToday}}",
    "proofKey": "themis/subrevamp/proof.png",
    "requestId": "subrevamp-p3-{{subRevampRun}}"
  }
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setEnvVar("subRevampPayment3Id", String(res.body.data.externalPayment.id));
}

tests {
  test("held as advance (no billing is current)", function() {
    const d = res.body.data;
    expect(d.duplicate).to.equal(false);
    expect(d.allocations.length).to.equal(0);
    expect(Number(d.advanceBalance)).to.be.closeTo(Number(bru.getEnvVar("subRevampAdvanceBalance")) + 6000, 0.011);
  });
}

docs {
  No billing is current (the last one was cancelled), so the whole amount is advance.
}
