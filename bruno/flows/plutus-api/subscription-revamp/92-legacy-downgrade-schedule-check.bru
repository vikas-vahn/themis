meta {
  name: 92. The legacy downgrade scheduled plan 7
  type: http
  seq: 92
}

get {
  url: {{baseUrl}}/api/subscriptions/details/torg/{{subRevampTorgId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("plan 7 is pending, plan 5 is still the current one", function() {
    const d = res.body.data;
    expect(d.plan.id).to.equal(5);
    expect(JSON.stringify(d)).to.contain("pending");
  });
}

docs {
  Looks for the pending plan in the details payload.
}
