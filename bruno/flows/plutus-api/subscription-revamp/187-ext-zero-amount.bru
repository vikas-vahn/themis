meta {
  name: 187. External payment of 0 is refused
  type: http
  seq: 187
}

post {
  url: {{baseUrl}}/api/torgs/{{subRevampTorgId}}/external-payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 0,
    "mode": "UPI",
    "referenceNumber": "UTR-ZERO-{{subRevampRun}}",
    "paymentDate": "{{subRevampToday}}",
    "proofKey": "themis/subrevamp/proof.png",
    "requestId": "subrevamp-zero-{{subRevampRun}}"
  }
}

assert {
  res.body.statusCode: eq 400
}
