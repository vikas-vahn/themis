meta {
  name: 105. Cancel of another torg's billing as this torg's admin is refused
  type: http
  seq: 105
}

post {
  url: {{baseUrl}}/api/subscriptions/1/billings/1/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refundMode": "FULL",
    "reason": "should not work"
  }
}

assert {
  res.body.statusCode: eq 403
}

docs {
  Another torg is only addressed; nothing is read or changed.
}
