meta {
  name: 144. POST /select-plan-onboarding in TRIAL (as the torg admin)
  type: http
  seq: 144
}

post {
  url: {{baseUrl}}/api/subscriptions/select-plan-onboarding
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampTorgToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "planId": 11
  }
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("plan is now 11 (half-yearly)", function() {
    expect(res.body.data.plan.id).to.equal(11);
  });
}

docs {
  Onboarding selection: unflagged, only in PENDING or TRIAL, and with plan change on only while no billing is current.
}
