meta {
  name: 112. Cancelling the same billing again is refused
  type: http
  seq: 112
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/billings/{{subRevampBillingId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refundMode": "FULL",
    "trialEndDate": "{{subRevampPlus1}}",
    "reason": "second cancel"
  }
}

assert {
  res.body.statusCode: eq 400
}
