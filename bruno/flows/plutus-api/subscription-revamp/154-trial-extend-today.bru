meta {
  name: 154. End the trial today so the scheduler bills now
  type: http
  seq: 154
}

post {
  url: {{baseUrl}}/api/subscriptions/{{subRevampTorgId}}/trial/extend?trialEndDate={{subRevampToday}}&reason=ENG-690%20test
  body: none
  auth: bearer
}

auth:bearer {
  token: {{subRevampAdminToken}}
}

assert {
  res.body.statusCode: eq 200
}

tests {
  test("next billing is today", function() {
    expect(res.body.data.nextBillingDate).to.equal(bru.getEnvVar("subRevampToday"));
  });
}

docs {
  After this the hourly scheduler creates the next billing. WAIT for it (up to an hour), then run 155. The flags must be OFF at that tick: steps 157-173 expect the legacy-maths billing it then makes (charged from the wallet only, advance untouched). With the flags on it is paid in full from advance and 160-173 fail with 400.
}
