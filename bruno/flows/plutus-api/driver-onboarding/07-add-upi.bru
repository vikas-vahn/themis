meta {
  name: 7. Add UPI
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/vpas/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "vpa": "{{driverVpa}}"
  }
}

docs {
  Adds and verifies a UPI ID in one call. Name is taken from the driver's own profile, same as
  the bank account step — there's no name field to fill in here either.

  This is an alternative to step 6, not a required follow-up — a driver only needs one verified
  payout method (bank account or UPI).
}
