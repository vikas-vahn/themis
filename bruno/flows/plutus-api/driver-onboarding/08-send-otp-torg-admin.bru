meta {
  name: 8. Send OTP (Torg Admin, for BUG-178 check)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/send-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{torgAdminPhone}}"
  }
}

docs {
  Start of the BUG-178 regression check (steps 8–14) — see this journey's `folder.bru` for why
  it needs an admin token rather than a driver's. Same login endpoint as step 1, but for
  `torgAdminPhone` (set this to a real TORG_ADMIN's phone in the "staging" environment first,
  same variable `torg-driver-mapping` uses).
}
