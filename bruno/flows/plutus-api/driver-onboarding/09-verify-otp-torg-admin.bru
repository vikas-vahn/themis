meta {
  name: 9. Verify OTP (Torg Admin, for BUG-178 check)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{torgAdminPhone}}",
    "otp": "{{torgAdminOtp}}"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.data.accessToken);
}

docs {
  Overwrites {{accessToken}} with the torg admin's token, same as `torg-driver-mapping` step 2 —
  everything from here through step 14 acts as the admin, not driver A. That's deliberate: steps
  11/12/14 hit VPA endpoints that either require an admin-level role outright, or that we want
  to exercise without depending on driver A's session still being valid.

  If you need driver A's token again afterwards, re-run this flow's own step 2.
}
