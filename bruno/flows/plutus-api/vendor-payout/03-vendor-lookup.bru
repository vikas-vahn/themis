meta {
  name: 3. Resolve vendor UPI ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/vpas/vendor-lookup?identifier={{vendorPayoutUpiId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: isNumber
}

script:post-response {
  bru.setEnvVar("vendorPayoutVpaId", res.body.data.id);
}

docs {
  Turns a UPI ID (or mobile number) into a VPA row the payout can target, creating a
  driver-less VPA plus a torg mapping the first time. Captures {{vendorPayoutVpaId}}.
  On staging the bank-resolved name is always "Test User".
}
