meta {
  name: 2. Verify OTP (Fleet Owner)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{vendorPayoutOwnerPhone}}",
    "otp": "{{vendorPayoutOwnerOtp}}"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.user.role: eq TORG_ADMIN
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.data.accessToken);
}

docs {
  Captures {{accessToken}}; every later step acts as this fleet owner. Blank `accessToken` in
  `environments/staging.bru` before committing.
}
