meta {
  name: Admin force-deletes VERIFIED truck A (204)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/trucks/admin/{{plutusApiTruckForceDeleteAId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{plutusApiTruckForceDeleteAdminToken}}
}

headers {
  Content-Type: application/json
}

assert {
  res.body.statusCode: eq 204
}

docs {
  VAHN_ADMIN only. Soft-deletes a truck even when verificationStatus=VERIFIED, unassigning its driver first (no driver here). Staging wraps the 204 as HTTP 200 with `statusCode: 204` in the body.
}
