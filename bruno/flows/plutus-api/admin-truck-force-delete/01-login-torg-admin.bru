meta {
  name: Login as TORG_ADMIN (non-admin caller)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{plutusApiTruckForceDeleteTorgPhone}}",
    "otp": "{{plutusApiTruckForceDeleteTorgOtp}}"
  }
}

assert {
  res.body.statusCode: eq 200
}

script:post-response {
  bru.setVar("plutusApiTruckForceDeleteTorgToken", res.body.data.accessToken);
}

docs {
  Logs in the torg admin of the test torg (OTP 776677 on staging). The token is a runtime var, used only to prove the admin routes refuse a non-VAHN_ADMIN caller.
}
