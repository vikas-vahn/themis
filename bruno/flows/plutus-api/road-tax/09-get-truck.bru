meta {
  name: 9. Truck detail shows truckDocuments.roadTax
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/trucks/{{plutusRoadTaxTruckId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{plutusRoadTaxToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
  res.body.data.truckDocuments.roadTax.paidFor: eq QUARTERLY
  res.body.data.truckDocuments.roadTax.validUpto: eq 2026-12-31
  res.body.data.truckDocuments.roadTax.source: eq USER
}

tests {
  test("permit blocks carry the read-only expiry fields when present", function () {
    const docs = res.body.data.truckDocuments;
    ["permit", "nationalPermit"].forEach(function (k) {
      if (docs[k]) { expect(docs[k], k).to.have.property("expiryStatus"); }
    });
  });
}

docs {
  `truckDocuments.roadTax` is absent when the truck has no tax row; after step 6 it is present.
  `permit` and `nationalPermit` carry validFrom, issuingAuthority, expiryStatus and daysLeft.
}
