meta {
  name: Delete Reply R
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/notes/{{plutusApiRemarksReplyR}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{plutusApiRemarksToken}}
}

assert {
  res.body.statusCode: eq 204
}

docs {
  Soft-deletes the reply (author, within 15 minutes).
}
