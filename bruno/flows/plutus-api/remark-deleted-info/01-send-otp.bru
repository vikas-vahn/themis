meta {
  name: Send OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/send-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{plutusApiRemarksPhone}}"
  }
}

assert {
  res.body.statusCode: eq 200
}

docs {
  Sends a login OTP to the remarks test user (`plutusApiRemarksPhone`). On staging the OTP is always 667766.
}
