meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{plutusApiNotesPhone}}",
    "otp": "{{plutusApiNotesOtp}}"
  }
}

script:post-response {
  bru.setVar("plutusApiNotesToken", res.body.data.accessToken);
  // The JWT `sub` is the user id; step 5 uses it to check authorship.
  const payload = JSON.parse(Buffer.from(res.body.data.accessToken.split(".")[1], "base64").toString());
  bru.setVar("plutusApiNotesUserId", Number(payload.sub));
}

assert {
  res.body.statusCode: eq 200
  res.body.data.role: eq TORG_ADMIN
}

docs {
  Redeems the OTP and keeps the bearer token in the runtime var `plutusApiNotesToken` (not written to the
  environment file), plus the user id in `plutusApiNotesUserId`. The user must be a torg user (notes
  can't be created by VAHN_ADMIN without a torgId, and "latest unread" forbids VAHN_ADMIN).
}
