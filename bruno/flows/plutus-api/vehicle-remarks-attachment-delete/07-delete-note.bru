meta {
  name: Delete Note
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/notes/{{plutusApiNotesNoteId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{plutusApiNotesToken}}
}

assert {
  res.body.statusCode: eq 204
}

docs {
  Deletes the note (author, within 15 minutes). The note is soft-deleted and its attachment files are
  removed from storage right after the transaction commits (BUG-691).
}
