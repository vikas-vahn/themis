meta {
  name: Attach trucks to the PAN
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/trucks/attach-to-pan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{plutusApiAdminPanIoclAdminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "panNumber": "{{plutusApiAdminPanIoclPanNumber}}",
    "truckIds": [{{plutusApiAdminPanIoclTruckIds}}]
  }
}

assert {
  res.body.statusCode: eq 200
  res.body.data.count: gte 1
}

docs {
  `TruckResource.attachTrucksToPan` (VAHN_ADMIN, TORG_ADMIN) -> `TruckService.attachTrucksToPANCard`.
  `plutusApiAdminPanIoclTruckIds` is a comma-separated list (`101,102`). As VAHN_ADMIN there is no torg
  check, so make sure the trucks belong to the PAN's torg. It replaces the trucks' PAN. Trucks already
  VERIFIED stay VERIFIED (the ownership check skips them). Then it queues `createFuelCardAsync` with no
  provider for each VERIFIED truck with a driver: IOCL first, BPCL if IOCL fails.
}
