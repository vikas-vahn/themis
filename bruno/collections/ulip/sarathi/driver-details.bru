meta {
  name: driver-details
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/ulip/v1.0.0/SARATHI/01
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ulipToken}}
}

body:json {
  {
    "dlnumber": "{{process.env.ULIP_DL_NUMBER}}",
    "dob": "{{process.env.ULIP_DOB}}"
  }
}

vars:pre-request {
  ulipToken: eyJhbGciOiJIUzUxMiJ9.eyJhcHBzIjoiYXBpR2F0ZXdheSIsInN1YiI6Imd0Y3ZfdmFobl91c3IiLCJpYXQiOjE3OTAwODg0NDh9.GqwW_HsqWu5ZKKHD-RALpK70hQxwwj5J4b05LdxJgY_pEq8Uqsq-1eEenoNW-wbqleTPQGQ8bWF-5BOTIgzEKQ
}

tests {
  test("SARATHI returned a result", function () {
    const result = res.getBody().response[0];
    expect(result.responseStatus, JSON.stringify(result)).to.equal("SUCCESS");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  `POST /ulip/v1.0.0/SARATHI/01` with `{"dlnumber","dob"}` (`dob` as `yyyy-MM-dd`): the driver's
  licence details from the Sarathi DL database (name, address, validity, vehicle classes, photo).
  Result is in `response[0].response`; `response[0].responseStatus` is `SUCCESS` when the DL/DOB pair
  matched. Run `auth/login` first.
}
​