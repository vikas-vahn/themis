meta {
  name: Log in as the torg owner (TORG_ADMIN)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{plutusTripFinanceOwnerPhone}}",
    "otp": "{{plutusTripFinanceOtp}}"
  }
}

script:post-response {
  bru.setVar("plutusTripFinanceOwnerToken", res.body.data.accessToken);
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
  res.body.success: eq true
  res.body.data.accessToken: isString
}

docs {
  Staging OTP is 776677. Logs in the torg 315 TORG_ADMIN (`plutusTripFinanceOwnerPhone`) and keeps the
    bearer token in the runtime var `plutusTripFinanceOwnerToken`, so nothing is written into the env file.
    The other trip-finance requests use it.
}
