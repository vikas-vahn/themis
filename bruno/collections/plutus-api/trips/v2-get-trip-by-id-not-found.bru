meta {
  name: Trips v2 get by id - not found
  type: http
  seq: 112
}

get {
  url: {{baseUrl}}/api/trips/v2/99999999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 400
}

docs {
  Unknown trip id: body statusCode 400 "Trip not found" (HTTP status stays 200).
}
