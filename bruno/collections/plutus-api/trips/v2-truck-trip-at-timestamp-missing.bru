meta {
  name: Trips v2 truck trip at timestamp - timestamp missing
  type: http
  seq: 140
}

get {
  url: {{baseUrl}}/api/trips/v2/truck/{{plutusApiTruckIdMultiStop}}/at-timestamp
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 400
}

docs {
  timestamp is required: body statusCode 400.
}
