meta {
  name: Trips v2 truck PnL (lean)
  type: http
  seq: 125
}

get {
  url: {{baseUrl}}/api/trips/v2/truck/{{plutusApiTruckIdMultiStop}}/pnl?startDate=2026-01-01&endDate=2026-12-31
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("totals and rows", function () {
    const d = res.body.data;
    ["totalRevenue", "totalExpenses", "pnl", "trips"].forEach(function (k) { expect(d, k).to.have.property(k); });
    expect(d.trips).to.be.an("array").that.is.not.empty;
  });

  test("same totals and trip count as the v1 route (run Get truck PnL first)", function () {
    const v1 = bru.getVar("plutusApiPnlV1");
    if (!v1) { return; }
    const o = JSON.parse(v1);
    expect(res.body.data.totalRevenue).to.equal(o.totalRevenue);
    expect(res.body.data.totalExpenses).to.equal(o.totalExpenses);
    expect(res.body.data.pnl).to.equal(o.pnl);
    expect(res.body.data.trips.length).to.equal(o.rows);
  });

  test("customerNames is an array of strings wherever it is sent", function () {
    res.body.data.trips.forEach(function (t) {
      if (t.customerNames !== undefined && t.customerNames !== null) {
        expect(t.customerNames).to.be.an("array");
      }
    });
  });

  test("lean rows: no truck/driver graph, managers or expense list", function () {
    res.body.data.trips.forEach(function (r) {
      ["truck", "truckManager", "fundManager", "truckManagers", "fundManagers", "tripExpenses", "expenseSummary",
       "createdById", "createdByName", "vtsOdometerStartReading", "vtsOdometerEndReading"].forEach(function (k) {
        expect(r, k).to.not.have.property(k);
      });
      ["id", "tripNumber", "status", "freightCharge", "totalTripExpenses"].forEach(function (k) { expect(r, k).to.have.property(k); });
      (r.lorryReceipts || []).forEach(function (lr) { expect(lr).to.not.have.property("lrUrl"); });
      if (r.driver) {
        Object.keys(r.driver).forEach(function (k) { expect(["id", "name", "phone"]).to.include(k); });
      }
    });
  });
}

docs {
  ENG-1335 R7: GET /api/trips/truck/{truckId}/pnl with lean trip rows. Same trips, order and totals;
  not paged. The comparison with v1 needs "Get truck PnL" to have run earlier in the same run
  (it stores the totals in a runtime variable). Truck must belong to the caller's torg (VAHN_ADMIN: any).
}
