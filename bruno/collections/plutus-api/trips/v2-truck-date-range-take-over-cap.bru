meta {
  name: Trips v2 by truck - date range, take over cap
  type: http
  seq: 123
}

get {
  url: {{baseUrl}}/api/trips/v2/truck/{{plutusApiTruckIdMultiStop}}/date-range?startDate=2026-01-01&endDate=2026-12-31&take=201
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 400
}

docs {
  take must be 1-200: body statusCode 400.
}
