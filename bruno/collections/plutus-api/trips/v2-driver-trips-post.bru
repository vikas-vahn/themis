meta {
  name: Trips v2 by driver (POST date range)
  type: http
  seq: 103
}

post {
  url: {{baseUrl}}/api/trips/v2/driver/{{plutusApiPaginationDriverId}}?skip=0&take=2
  body: json
  auth: bearer
}

auth:bearer {
  token: {{plutusApiDriverToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "startDate": "2020-01-01",
    "endDate": "2030-12-31"
  }
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("envelope shape and hasMore", function () {
    const e = res.body.data;
    expect(e.data).to.be.an("array");
    expect(e.skip).to.equal(0);
    expect(e.take).to.equal(2);
    expect(e.total).to.be.a("number");
    expect(e.data.length).to.be.at.most(e.take);
    expect(e.hasMore).to.equal(e.skip + e.data.length < e.total);
  });
}

docs {
  A read with a date-range body; same envelope as the GET. ENG-1335 skip/take envelope: asserts skip=0, take=2, hasMore == skip + data.length < total.
}
