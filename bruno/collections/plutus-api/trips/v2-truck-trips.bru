meta {
  name: Trips v2 by truck (lean, paged)
  type: http
  seq: 132
}

get {
  url: {{baseUrl}}/api/trips/v2/truck/{{plutusApiTruckIdMultiStop}}?skip=0&take=3
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("skip/take envelope", function () {
    const e = res.body.data;
    expect(e.data).to.be.an("array");
    expect(e.skip).to.equal(0);
    expect(e.take).to.equal(3);
    expect(e.total).to.be.a("number");
    expect(e.data.length).to.be.at.most(e.take);
    expect(e.hasMore).to.equal(e.skip + e.data.length < e.total);
  });

  test("lean rows: no truck/driver graph, managers or expense list", function () {
    res.body.data.data.forEach(function (r) {
      ["truck", "truckManager", "fundManager", "truckManagers", "fundManagers", "tripExpenses", "expenseSummary",
       "createdById", "createdByName", "vtsOdometerStartReading", "vtsOdometerEndReading"].forEach(function (k) {
        expect(r, k).to.not.have.property(k);
      });
      ["id", "tripNumber", "status", "freightCharge", "totalTripExpenses"].forEach(function (k) { expect(r, k).to.have.property(k); });
      (r.lorryReceipts || []).forEach(function (lr) { expect(lr).to.not.have.property("lrUrl"); });
      if (r.driver) {
        Object.keys(r.driver).forEach(function (k) { expect(["id", "name", "phone"]).to.include(k); });
      }
    });
  });
}

docs {
  ENG-1335 R9: the trips of GET /api/trips/truck/{truckId} without the truck/driver graph and managers,
  newest first, skip/take. Truck must belong to the caller's torg (VAHN_ADMIN: any).
}
