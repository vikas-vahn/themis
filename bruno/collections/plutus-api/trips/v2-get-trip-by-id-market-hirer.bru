meta {
  name: Trips v2 get by id (market, hirer)
  type: http
  seq: 117
}

get {
  url: {{baseUrl}}/api/trips/v2/{{plutusApiTripIdMarket}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{plutusApiHirerToken}}
}

script:pre-request {
  if (!bru.getEnvVar("plutusApiHirerToken")) { bru.runner.skipRequest(); }
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("hirer sees the driver's personal keys masked", function () {
    const d = res.body.data.driver;
    expect(d).to.be.an("object");
    if (d.address) { expect(d.address).to.equal("****"); }
    if (d.dateOfBirth) { expect(d.dateOfBirth).to.equal("****-**-**"); }
    if (d.email) { expect(d.email).to.match(/^.\*\*\*@/); }
    if (d.aadhaarNumber) { expect(d.aadhaarNumber).to.match(/^X*\d{0,4}$/); }
    expect(d.aadhaarId === undefined || d.aadhaarId === null, "aadhaarId").to.equal(true);
  });
}

docs {
  ENG-1335: a hirer (Atorg) viewing a MARKET trip gets the driver's address ("****"), dateOfBirth
  ("****-**-**"), email (first character + "***" + domain) and aadhaarNumber (all but the last four
  characters as X) masked, and aadhaarId null (DriverPiiMask). The owner and VAHN_ADMIN see full values.
  Needs {{plutusApiHirerToken}}: a login of the Atorg that requested {{plutusApiTripIdMarket}}; skipped
  when empty.
}
