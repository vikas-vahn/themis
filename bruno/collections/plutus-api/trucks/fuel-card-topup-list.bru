meta {
  name: Trucks fuel-card-topup-list (Home picker)
  type: http
  seq: 412
}

get {
  url: {{baseUrl}}/api/trucks/fuel-card-topup-list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{homeRevampToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  const CARD_FIELDS = ["fuelCardId", "cardNumber", "provider", "cardStatus", "balance", "balanceUpdatedAt", "lastTopUpAt", "lowBalance", "limitBased"];

  test("array of picker rows with the card flags", function () {
    expect(res.body.data).to.be.an("array");
    res.body.data.forEach(function (r) {
      expect(r.truck, "truck").to.be.an("object");
      expect(r.hasFuelCard, "hasFuelCard").to.be.a("boolean");
      expect(r.onRunningTrip, "onRunningTrip").to.be.a("boolean");
      expect(r, "lowBalance").to.have.property("lowBalance");
      expect(r, "limitBased").to.have.property("limitBased");
      expect(r, "PIN is left out").to.not.have.property("cardPin");
    });
  });

  test("card rows carry the card, cardless rows have every card field null", function () {
    res.body.data.forEach(function (r) {
      if (r.hasFuelCard) {
        expect(r.fuelCardId, "fuelCardId").to.be.a("number");
        expect(r, "balance").to.have.property("balance");
        expect(r.lowBalance, "lowBalance").to.be.a("boolean");
        expect(r.limitBased, "limitBased").to.be.a("boolean");
      } else {
        CARD_FIELDS.forEach(function (k) {
          expect(r, k + " present").to.have.property(k);
          expect(r[k], k + " null on a cardless row").to.equal(null);
        });
      }
    });
  });

  test("every card row comes before every cardless row", function () {
    const rows = res.body.data;
    const firstCardless = rows.findIndex(function (r) { return !r.hasFuelCard; });
    if (firstCardless >= 0) {
      rows.slice(firstCardless).forEach(function (r) { expect(r.hasFuelCard, "card row after a cardless row").to.equal(false); });
    }
  });

  test("running trip first in both groups", function () {
    [true, false].forEach(function (hasCard) {
      const g = res.body.data.filter(function (r) { return r.hasFuelCard === hasCard; });
      const firstOff = g.findIndex(function (r) { return !r.onRunningTrip; });
      if (firstOff >= 0) {
        g.slice(firstOff).forEach(function (r) { expect(r.onRunningTrip, "running row after an off-trip row").to.equal(false); });
      }
    });
  });

  test("card rows: within a running-trip group, balance ascending with nulls last", function () {
    const rows = res.body.data.filter(function (r) { return r.hasFuelCard; });
    [true, false].forEach(function (running) {
      const g = rows.filter(function (r) { return r.onRunningTrip === running; });
      let sawNull = false;
      let prev = null;
      g.forEach(function (r, i) {
        if (r.balance === null || r.balance === undefined) { sawNull = true; return; }
        expect(sawNull, "balance after a null balance at " + i).to.equal(false);
        const v = Number(r.balance);
        if (prev !== null) { expect(v, "balance asc at " + i).to.be.at.least(prev); }
        prev = v;
      });
    });
  });

  test("cardless rows: within a running-trip group, registration A-Z", function () {
    const rows = res.body.data.filter(function (r) { return !r.hasFuelCard; });
    [true, false].forEach(function (running) {
      const regs = rows.filter(function (r) { return r.onRunningTrip === running; })
                       .map(function (r) { return String(r.truck.registrationNumber || ""); });
      for (let i = 1; i < regs.length; i++) {
        expect(regs[i].localeCompare(regs[i - 1]), "registration order at " + i).to.be.at.least(0);
      }
    });
  });
}

docs {
  Home Top Up Fuel Card picker (FuelCardTopUpPickerItem, order PickerOrder.FUEL_CARD_TOP_UP): every truck
  of the caller, no paging. Same roles as pay-driver-list. Trucks with no default card are included with
  hasFuelCard false and every card field null (fuelCardId, cardNumber, provider, cardStatus, balance,
  balanceUpdatedAt, lastTopUpAt, lowBalance, limitBased). Every row has hasFuelCard, lowBalance, limitBased.
  Order: every card row first (running trip first, then balance ascending, nulls last), then the cardless
  rows (running trip first, then registration A-Z). Balance is the last provider sync. Read only. Needs the
  "Home revamp login" token (homeRevampToken).
}
