meta {
  name: Refresh Road Tax
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/api/trucks/{{plutusApiRoadTaxTruckId}}/road-tax/refresh
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  plutusApiRoadTaxTruckId: 1255
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
  res.body.data.lastFetchResult: isString
  res.body.data.lastFetchedAt: isString
  res.body.data.refreshAvailable: eq false
}

docs {
  `TruckResource.refreshRoadTax` (ENG-1398). Roles VAHN_ADMIN, TORG_ADMIN, TRUCK_MANAGER, FUND_MANAGER.
  Fetches the tax date now: ULIP VAHAN first, then **paid Surepass** as fallback. A later date replaces the current one.

  Limits: non-admins get one refresh per truck per IST day, then 429 ("Road tax was already refreshed today. Try again tomorrow").
  VAHN_ADMIN is not limited. Unknown truck: 404. Each call can bill Surepass, so do not loop it.
  After a refresh, `refreshAvailable` is false for non-admin callers until tomorrow.
}
