meta {
  name: Truck GVW list
  type: http
  seq: 212
}

get {
  url: {{baseUrl}}/api/trucks/gvw-list
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("distinct ascending capacities", function () {
    const g = res.body.data;
    expect(g).to.be.an("array").that.is.not.empty;
    g.forEach(function (x) { expect(x).to.be.a("number"); });
    for (let i = 1; i < g.length; i++) { expect(g[i]).to.be.greaterThan(g[i - 1]); }
  });
}

docs {
  Distinct truck capacities (tons), ascending, in the caller's scope. ENG-1335 moved this to one
  SELECT DISTINCT; the response shape is unchanged (array of numbers).
}
