meta {
  name: Trucks v2 get by id (lean, non-owner)
  type: http
  seq: 204
}

get {
  url: {{baseUrl}}/api/trucks/v2/{{plutusApiTruckIdMultiStop}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("lean truck keys", function () {
    const t = res.body.data;
    ["id", "registrationNumber", "make", "model", "status", "truckMasterId", "truckDocuments", "fuelCards", "fastag", "trip"].forEach(function (k) {
      expect(t, k).to.have.property(k);
    });
    ["fuelCardBalance", "isFuelCardLowBalance", "lastMaintenanceDate", "nextMaintenanceDate", "fundManagerId",
     "torgId", "createdAt", "axleCount", "netcVehicleClass", "highestAlertLevel", "truckMaster"].forEach(function (k) {
      expect(t, k).to.not.have.property(k);
    });
  });

  test("non-owner viewer gets a masked fuel-card number and no pin", function () {
    const cards = res.body.data.fuelCards;
    expect(cards).to.be.an("array").that.is.not.empty;
    cards.forEach(function (c) {
      expect(c.pin === undefined || c.pin === null, "pin").to.equal(true);
      expect(String(c.cardNumber), "cardNumber").to.match(/[Xx*]/);
      ["expiryDate", "updatedAt", "torgId", "last_changed_by_name"].forEach(function (k) { expect(c, k).to.not.have.property(k); });
    });
  });

  test("fastag is trimmed", function () {
    const f = res.body.data.fastag;
    if (f) {
      ["torgId", "vehicleId", "vehicleClass", "issuerBankId", "minBalance", "linkedWalletId", "kycCompliance", "remarks"].forEach(function (k) {
        expect(f, k).to.not.have.property(k);
      });
      if (f.biller) {
        Object.keys(f.biller).forEach(function (k) { expect(["id", "billerId", "billerName"]).to.include(k); });
      }
    }
  });

  test("managers are summaries and the trip drops its internal keys", function () {
    const t = res.body.data;
    ["truckManager", "fundManager"].forEach(function (k) {
      if (t[k]) {
        Object.keys(t[k]).forEach(function (f) {
          expect(["id", "phone", "name", "image", "email", "role", "lastLoginAt"]).to.include(f);
        });
        expect(t[k]).to.not.have.property("vp");
      }
    });
    ["createdById", "createdByName", "vtsOdometerStartReading", "vtsOdometerEndReading"].forEach(function (k) {
      expect(t.trip, k).to.not.have.property(k);
    });
  });

  test("driver is lean", function () {
    const d = res.body.data.driver;
    if (d) {
      ["truckDTO", "email", "address", "ownerId", "updatedAt", "dlVerificationDate"].forEach(function (k) { expect(d, k).to.not.have.property(k); });
    }
  });
}

docs {
  ENG-1335 lean truck detail: GET /api/trucks/{id} without the keys no client reads (no nested
  driver truck, managers as summaries, trimmed FASTag). Fuel-card pin and full cardNumber are sent
  only when the viewer's torg owns the truck, so with the static VAHN_ADMIN token (no torg) the
  number is masked and pin is null. The owner-side check is "Trucks v2 get by id (owner)".
  Roles include DRIVER. {{plutusApiTruckIdMultiStop}} must be a truck with a fuel card and a
  multi-stop trip (staging data).
}
