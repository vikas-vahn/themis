meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{driverPhone}}",
    "otp": "{{driverOtp}}"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.data.accessToken);
}

docs {
  Exchanges the OTP from "Send OTP" for a bearer token. On success this sets {{accessToken}}
  automatically — every other request in this collection uses that variable.

  If the phone number has never logged in before, `data.role` in the response is NEW_USER; no
  User/Driver record exists yet. See the driver-onboarding flow (bruno/flows/plutus-api/
  driver-onboarding/) for the full self-registration sequence that follows from there.
}
