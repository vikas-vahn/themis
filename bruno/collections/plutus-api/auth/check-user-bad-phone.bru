meta {
  name: Check user - bad phone (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/auth/check-user
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "12345"
  }
}

assert {
  res.body.statusCode: eq 400
  res.body.success: eq false
}

tests {
  test("message explains the 10-digit rule", function () {
    expect(res.body.message).to.contain("valid 10-digit mobile number");
  });
}

docs {
  Not a valid 10-digit mobile number gives 400. Staging delivers it as HTTP 200 with statusCode 400
  in the body, so only the body is asserted.
}
