meta {
  name: Send OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/send-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{torgPhone}}"
  }
}

vars:pre-request {
  driverPhone: 9360245308
  torgPhone: 9999996000
}

docs {
  Sends a login OTP to the given phone number. Works for both new and existing users — there's
  no separate "does this number exist" check.
  
  In staging/dev (shared DB), the OTP is a fixed 776677 for every user — see "Verify OTP" for
  redeeming it.
}
