meta {
  name: Check user - does not exist
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/auth/check-user
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{homeRevampUnusedPhone}}"
  }
}

vars:pre-request {
  homeRevampUnusedPhone: 9000000001
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("exists=false and role is null", function () {
    expect(res.body.data.exists).to.equal(false);
    expect(res.body.data.role).to.equal(null);
  });
}

docs {
  Same endpoint with a number nobody uses (homeRevampUnusedPhone, 9000000001). Pick another 9xxxxxxxxx
  number if staging ever gains a user with this one.
}
