meta {
  name: Get Note Category
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/note-categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  One category, including a deleted one (`deleted: true`). Every notes role. 404 "Category not found".
}
