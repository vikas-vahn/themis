meta {
  name: Update Note
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/notes/{{noteId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "content": "Tyre replaced at Nagpur, bill received"
  }
}

docs {
  Edits a note's text (`NoteResource.updateNote`, service `NoteService.updateNote`). Only the author can
  edit, not even an admin. Works the same for replies.

  200 with the note; `edited` becomes true and `editedAt` is set.

  403 "Only the author can edit a note". 404 "Note not found" for an unknown, other-torg or deleted note.
  422 if `content` is blank or over 2000 characters.
}
