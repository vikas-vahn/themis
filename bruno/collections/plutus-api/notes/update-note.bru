meta {
  name: Update Note
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/notes/{{noteId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "content": "Tyre replaced at Nagpur, bill received"
  }
}

docs {
  Edits a note (`NoteResource.updateNote`, service `NoteService.updateNote`). Only the author can edit,
  not even an admin. For trucks, only within 15 minutes of the note being added. Works the same for
  replies.

  `content` is always required. `attachments`, when sent, replaces the note's files (`[]` removes them
  all); leave it out to keep them. Same rules as on create.

  200 with the note; `edited` becomes true and `editedAt` is set.

  403 "Only the author can edit a note", or "A note can only be edited within 15 minutes of being added".
  404 "Note not found" for an unknown, other-torg or deleted note. 400 if `content` is blank or over 2000
  characters, or for invalid attachments.
}
