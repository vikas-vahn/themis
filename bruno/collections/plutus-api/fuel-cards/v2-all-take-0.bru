meta {
  name: Fuel cards v2 all - take=0 rejected
  type: http
  seq: 102
}

get {
  url: {{baseUrl}}/api/fuel-cards/v2/all?take=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{plutusApiTorgAdminToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 400
}

docs {
  Boundary case: take must be 1-200, so take=0 returns body statusCode 400 (HTTP status stays 200).
}
