meta {
  name: Drivers v2 get by user id - not found
  type: http
  seq: 121
}

get {
  url: {{baseUrl}}/api/drivers/v2/user/99999999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 404
}

docs {
  No driver for that user: body statusCode 404.
}
