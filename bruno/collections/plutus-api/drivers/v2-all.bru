meta {
  name: Drivers v2 all (lean, VAHN_ADMIN)
  type: http
  seq: 110
}

get {
  url: {{baseUrl}}/api/drivers/v2?skip=0&take=2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminStaticToken}}
}

assert {
  res.status: eq 200
  res.body.statusCode: eq 200
}

tests {
  test("skip/take envelope", function () {
    const e = res.body.data;
    expect(e.data).to.be.an("array");
    expect(e.skip).to.equal(0);
    expect(e.take).to.equal(2);
    expect(e.total).to.be.a("number");
    expect(e.data.length).to.be.at.most(e.take);
    expect(e.hasMore).to.equal(e.skip + e.data.length < e.total);
  });

  test("every driver field, without the nested truckDTO", function () {
    const rows = res.body.data.data;
    expect(rows).to.be.an("array").that.is.not.empty;
    rows.forEach(function (d) {
      ["id", "name", "phone", "status", "ownerId", "licenseNumber", "vpas"].forEach(function (k) { expect(d, k).to.have.property(k); });
      expect(d).to.not.have.property("truckDTO");
    });
  });
}

docs {
  ENG-1335 R10: GET /api/drivers (same name/torgId filters and order, id as tie-break) as a skip/take page,
  every driver field without truckDTO. VAHN_ADMIN only; v1 has no role check.
}
