}

body:form-urlencoded {
  channel: whatsapp
  source: 918008479933
  destination: 919121032575
  src.name: RItbOWWfbnTX1vRqkSBYpbPq
  template: {"id":"1cb92d27-8ebd-4220-a186-26bfc0d7eecb","params":["Akul","open/trial"]}
}

docs {
  Template prospect_welcome_01 (gsTemplateId 1cb92d27-...). Has a dynamic URL button: https://vahn.in/{{1}}.
  params = body placeholders in order, then the dynamic button URL suffix: ["<name>", "<url suffix>"].
  Response: 202 {"status":"submitted","messageId":"..."}.
}

settings {
  encodeUrl: false
  timeout: 0
}
