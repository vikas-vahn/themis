meta {
  name: origin-destination
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/origin-destination-waypoints
  body: json
  auth: none
}

body:json {
  {
    "from": { "lat": {{tollguruFromLat}}, "lng": {{tollguruFromLng}} },
    "to": { "lat": {{tollguruToLat}}, "lng": {{tollguruToLng}} },
    "vehicle": { "type": "{{tollguruVehicleType}}" },
    "units": { "currency": "{{tollguruCurrency}}" }
  }
}

script:post-response {
  // Runtime var only (bru.setVar), so the polyline is never written to the env file.
  const route = (res.getBody().routes || [])[0];
  if (route && route.polyline) {
    bru.setVar("tollguruRoutePolyline", route.polyline);
  }
}

tests {
  test("first route has a tag cost and plazas", function () {
    const route = res.getBody().routes[0];
    expect(route.costs.tag, JSON.stringify(route.costs)).to.be.a("number");
    expect(route.tolls).to.be.an("array").that.is.not.empty;
  });
}

docs {
  `POST /origin-destination-waypoints` with `{"from":{lat,lng},"to":{lat,lng},"vehicle":{"type"},"units":{"currency"}}`,
  exactly as `TollGuruClient` sends it when a trip has no polyline. plutus reads `routes[0].costs.tag`
  (falling back to `minimumTollCost`) and `routes[0].tolls[].name/tagCost`, doubling the cost for ROUND trips.
}

settings {
  encodeUrl: true
  timeout: 0
}
